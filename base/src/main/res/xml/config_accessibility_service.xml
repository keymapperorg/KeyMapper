<?xml version="1.0" encoding="utf-8"?><!--
    Deliberately declare no accessibilityFlags and no accessibilityEventTypes. They are requested
    at runtime by AccessibilityServiceInfoController, and only the ones that the features the user
    is actually using need. The capabilities below can not be narrowed at runtime because they are
    fixed when the service is bound.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:canRequestFingerprintGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_explanation"
    android:notificationTimeout="200" /><!-- IMPORTANT. Set an accessibility event timeout because WINDOW_CONTENT_CHANGED events can be sent very frequently. -->
